{
  "name": "@nicotind/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:tv": "playwright test --config=playwright.tv.config.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:unit": "bun test playground",
    "report": "playwright show-report",
    "playground": "PLAYGROUND=1 playwright test",
    "playground:real": "playwright test --config=playwright.real.config.ts",
    "screens:live": "playwright test --config=playwright.live-screens.config.ts",
    "screens:readme": "bun run scripts/update-readme-screenshots.ts",
    "make-fixtures": "bun run scripts/make-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "smoke:storybook": "node scripts/storybook-gates.mjs --smoke",
    "gates:storybook": "node scripts/storybook-gates.mjs --smoke --a11y --strict",
    "install:deps": "playwright install-deps chromium",
    "install:browsers": "playwright install chromium",
    "a11y:storybook": "node scripts/storybook-gates.mjs --a11y",
    "a11y:storybook:strict": "node scripts/storybook-gates.mjs --a11y --strict"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.5",
    "@types/node": "25.5.0"
  }
}
