{
  "name": "@nicotind/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capacitor shell (Android + iOS) wrapping the @nicotind/web build",
  "scripts": {
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "cap:add": "cap add android",
    "cap:sync:ios": "cap sync ios",
    "cap:open:ios": "cap open ios",
    "cap:add:ios": "cap add ios",
    "android:assemble": "cd android && ./gradlew assemblePhoneRelease",
    "android:assemble:tv": "cd android && ./gradlew assembleTvRelease",
    "icons:source": "bun run scripts/generate-native-icons.ts",
    "icons:generate": "bunx @capacitor/assets@3 generate",
    "fdroid:changelog": "bun run scripts/fdroid-changelog.ts",
    "android:version": "bun run scripts/android-version.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-media-session": "^8.0.32",
    "@nicotind/capacitor-now-playing": "workspace:*",
    "@nicotind/capacitor-apk-update": "workspace:*",
    "@nicotind/capacitor-tv-channels": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.3"
  }
}
