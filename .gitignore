node_modules/
dist/
*.tsbuildinfo
.env
.DS_Store
*.log
packages/web/dist/
# Stray in-place tsc output next to TS sources (real build emits to dist/)
packages/core/src/**/*.js
~/.nicotind/
.worktrees/
.superpowers/

# Python (analysis sidecar)
packages/analysis/.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Android signing keystores — never commit; supplied to CI via secrets
*.jks
*.keystore

# Dev artifacts — never track
coverage/
packages/web/.vscode/
docs/superpowers/

# Docker compose local overrides — machine-specific bind mounts / GPU setup
docker-compose.override*.yml
# Keep the sanitized example template tracked for newcomers
!docker-compose.override.example.yml

# Desktop packaging (Task 11) — generated by prepare-resources.ts / electron-builder
packages/desktop/resources/
packages/desktop/release/
packages/desktop/dist-scripts/
packages/desktop/dist-test/
# Multi-size app icon pack — regenerated from packages/web/public/icons/
# on every `bun run --filter @nicotind/desktop dist` by scripts/stage-icons.mjs
packages/desktop/build/icons/

# Playwright storageState — written here when the suite is run from the repo root
# instead of packages/e2e (its own .gitignore only covers packages/e2e/.auth/).
.auth/
packages/web/storybook-static
packages/web/documentation.json
.angular/
# The pinned actionlint binary. CI extracts it into the repo root
# (`tar -xz actionlint`), so anyone running that step locally ends up with a 5 MB
# executable sitting next to package.json — easy to `git add -A` by accident.
/actionlint
