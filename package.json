{
  "name": "nicotind",
  "version": "0.3.10",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Kevin Chavarria",
  "homepage": "https://github.com/kevinch3/NicotinD",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevinch3/NicotinD.git"
  },
  "bugs": {
    "url": "https://github.com/kevinch3/NicotinD/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "bun run ./scripts/dev.ts",
    "build": "bun run ./scripts/build.ts",
    "check:claude-md": "bun run ./scripts/check-claude-md.ts",
    "check:ci-parity": "bun run ./scripts/check-ci-parity.ts",
    "check:route-auth": "bun run ./scripts/check-route-auth.ts",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run check:bgutil-pin && bun run check:claude-md && bun run check:json && bun run check:shared-helpers && bun run check:ci-parity && bun run check:route-auth && bun run test && bun test packages/e2e/playground && bun run test:web && bun run --filter @nicotind/web build && bun run build:storybook && bun run smoke:storybook && bun run a11y:storybook:strict",
    "lint": "eslint --no-warn-ignored packages/*/src/**/*.ts src/**/*.ts packages/web/.storybook/*.ts",
    "format": "prettier --write 'packages/*/src/**/*.ts' 'src/**/*.ts' 'packages/web/.storybook/*.ts'",
    "format:check": "prettier --check 'packages/*/src/**/*.ts' 'src/**/*.ts' 'packages/web/.storybook/*.ts'",
    "typecheck": "tsc --build && bun run --filter @nicotind/e2e typecheck && bun run --filter @nicotind/web typecheck:template && bun run --filter @nicotind/web typecheck:spec",
    "check:bgutil-pin": "bun run ./scripts/check-bgutil-pin.ts",
    "check:shipped-issues": "bun run ./scripts/check-shipped-issues.ts",
    "check:json": "bun run ./scripts/check-json-configs.ts",
    "check:shared-helpers": "bun run ./scripts/check-shared-helpers.ts",
    "check:isolated-specs": "bun run ./scripts/check-isolated-specs.ts",
    "download-deps": "bun run ./scripts/download-deps.ts",
    "test": "bun test packages src scripts --path-ignore-patterns='**/dist/**' --path-ignore-patterns='**/dist-test/**' --path-ignore-patterns='**/.worktrees/**' --path-ignore-patterns='**/web/src/**' --path-ignore-patterns='**/e2e/**' --path-ignore-patterns='**/desktop/test/**'",
    "test:tdd": "bun --watch test packages src scripts --bail 1 --path-ignore-patterns='**/dist/**' --path-ignore-patterns='**/dist-test/**' --path-ignore-patterns='**/.worktrees/**' --path-ignore-patterns='**/web/src/**' --path-ignore-patterns='**/e2e/**' --path-ignore-patterns='**/desktop/test/**'",
    "test:coverage": "bun test packages src scripts --coverage --coverage-reporter=text --coverage-reporter=lcov --path-ignore-patterns='**/dist/**' --path-ignore-patterns='**/dist-test/**' --path-ignore-patterns='**/.worktrees/**' --path-ignore-patterns='**/web/src/**' --path-ignore-patterns='**/e2e/**' --path-ignore-patterns='**/desktop/test/**'",
    "e2e": "bun run --filter @nicotind/e2e test",
    "e2e:tv": "bun run packages/e2e/tv/preflight.ts",
    "test:api": "bun test packages/api/src --path-ignore-patterns='**/dist/**'",
    "test:web": "bun run --filter @nicotind/web test",
    "typecheck:web-spec": "bun run --filter @nicotind/web typecheck:spec",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "prepare": "husky",
    "build:storybook": "bun run --filter @nicotind/web build:storybook",
    "smoke:storybook": "bun run --filter @nicotind/e2e smoke:storybook",
    "a11y:storybook": "bun run --filter @nicotind/e2e a11y:storybook",
    "a11y:storybook:strict": "bun run --filter @nicotind/e2e a11y:storybook:strict"
  },
  "dependencies": {
    "@nicotind/api": "workspace:*",
    "@nicotind/core": "workspace:*",
    "@nicotind/lidarr-client": "workspace:*",
    "@nicotind/service-manager": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "^1.3.14",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "ajv": "^8",
    "commit-and-tag-version": "^13.1.0",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.ts": "prettier --write"
  },
  "overrides": {
    "@types/node": "25.5.0"
  }
}
