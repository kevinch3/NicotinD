# NicotinD Configuration
NICOTIND_PORT=8484
# Set to 0 to bind an OS-assigned ephemeral port (used by the desktop Electron
# sidecar). On startup the resolved port is printed to stdout as a single
# machine-readable line: "NICOTIND_LISTENING <port>". See docs/desktop-app.md.
# NICOTIND_BIND_HOST=127.0.0.1 restricts binding to loopback (desktop sidecar
# only); leave unset for server/Docker deployments, which must stay reachable
# on 0.0.0.0 for port mapping.
# NICOTIND_BIND_HOST=127.0.0.1
NICOTIND_DATA_DIR=~/.nicotind
NICOTIND_MUSIC_DIR=~/Music
NICOTIND_METADATA_FIX_ENABLED=true
NICOTIND_METADATA_FIX_MIN_SCORE=85

# Auto-acquisition loop: poll Lidarr's wanted/missing list and auto-hunt+download
# monitored albums Lidarr lacks (same engine as the interactive hunt). Off by
# default — it initiates downloads unattended. See docs/auto-acquisition-plan.md.
NICOTIND_AUTO_ACQUIRE_ENABLED=false

# Download recovery: auto-retry failed/truncated slskd transfers (slskd resumes
# the partial file) and fall back to another peer for tracks that keep failing.
NICOTIND_AUTO_RETRY_ENABLED=true
NICOTIND_RETRY_MAX_ATTEMPTS=3
NICOTIND_RETRY_INTERVAL_MS=15000
NICOTIND_RETRY_COOLDOWN_MS=60000
# Cross-peer album fallback: max recovery waves (recorded alternates + fresh
# per-track searches) before a hunt job is marked exhausted.
NICOTIND_FALLBACK_MAX_ATTEMPTS=5
# Drop an incoming MP3 when a FLAC of the same track is already in the album
# folder (avoids mixed MP3+FLAC duplicate albums). Off by default.
NICOTIND_PREFER_FLAC_SKIP_MP3=false
# Standardize lossless downloads (FLAC/WAV/…) on Opus before they enter the
# library (smaller files + uniform browser-native codec). Requires ffmpeg.
# Default-on at 192 kbps; already-lossy files are left untouched. Set ENABLED=false
# to keep originals.
NICOTIND_TRANSCODE_LOSSLESS_ENABLED=true
NICOTIND_TRANSCODE_LOSSLESS_BITRATE=192
# Absolute path to ffmpeg binary (e.g. for packaged builds). Defaults to PATH lookup.
# NICOTIND_FFMPEG_PATH=/opt/app/resources/ffmpeg

# Mode: "embedded" (manage sub-services) or "external" (connect to existing)
NICOTIND_MODE=embedded

# Deployment-wide acquisition kill-switch (#235). Set to "off"/"false" for a
# lighter "streaming/library-only" install: the whole acquisition module is
# disabled — every acquisition route hard-404s, the watchlist/auto-acquire
# pollers never start, and the web hides Downloads + Search's acquire surfaces.
# Default (unset/"on") preserves full acquisition. No slskd/Lidarr needed when off.
NICOTIND_ACQUISITION=on

# Public self-signup. Leave UNSET (the default) and the Admin -> User Management
# toggle owns it, starting closed — accounts are created there instead, audited
# as `user.create`, which POST /register never was. Setting this to "off"/"on"
# PINS the value in either direction and renders that toggle read-only, for
# operators who want the decision fixed by the deployment rather than by whoever
# holds an admin account. The first-user bootstrap is exempt either way.
# NICOTIND_REGISTRATION=off

# Soulseek acquisition lives on the slskd addon since phase 3 (issue #490):
# creds + slskd URL are configured on the addon container (SLSKD_ADDON_* envs
# in docker-compose.yml's `slskd-addon` profile), then pushed from the
# Extensions card — nothing Soulseek-related is read from this file anymore.

# yt-dlp URL resolution lives on the external ytdlp-addon since the phase-4
# split. It's opt-in: `docker compose --profile ytdlp-addon up -d` (brings the
# addon + its own PO-token provider companion), then register it in Extensions →
# "Add a remote addon" at http://ytdlp-addon:8586 with the token below.
# YTDLP_ADDON_TOKEN=change-me

# spotDL URL resolution (Spotify track/album/playlist URLs) lives on the external
# spotdl-addon since the phase-4 split. Opt-in: `docker compose --profile
# spotdl-addon up -d` (brings the addon + its PO-token provider companion), then
# register it in Extensions → "Add a remote addon" at http://spotdl-addon:8587
# with the token below. The Spotify creds below are forwarded to it (optional).
# SPOTDL_ADDON_TOKEN=change-me

# Spotify metadata fallback lane (optional). Used to find an album in the Spotify
# catalog when Soulseek comes up empty, then download it via the spotDL addon.
# Register an app at https://developer.spotify.com/dashboard for these. Primary
# path is Settings → Plugins; these env vars just seed the credentials headlessly
# (and are forwarded to the spotdl-addon to raise its Spotify rate limits).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Audio-analysis sidecar (packages/analysis) — fills mood/valence/danceability/
# acousticness/instrumentalness + cached embeddings. Optional; leave unset to
# run without it. Docker compose sets http://analysis:8000.
NICOTIND_ANALYSIS_URL=

# Process-before-landing gate — set to 1 to DISABLE it (downloads then appear in
# the library immediately, without waiting for their required processing steps).
# Off by default (gate active). Mainly an ops/test escape hatch.
# NICOTIND_DISABLE_LANDING_GATE=

# Error tracking (Sentry) — opt-in. Leave DSN empty to disable entirely.
NICOTIND_SENTRY_DSN=
NICOTIND_SENTRY_TRACES_SAMPLE_RATE=0.1

# Daily backups (DB snapshot + secrets into <dataDir>/backups, pruned to the
# newest N; see docs/backup-restore.md). On by default — set NICOTIND_BACKUP=off
# to disable the schedule (the Admin "Back up now" button still works).
# NICOTIND_BACKUP=off
# NICOTIND_BACKUP_KEEP=7

# Snapshot the database immediately before a schema migration (only when the
# schema version actually advances, so an ordinary restart costs nothing). A
# failure ABORTS the boot rather than migrating without a net; set this to off
# to accept that risk. Deliberately NOT implied by NICOTIND_BACKUP=off, which
# means "no daily snapshots" — a different thing. See docs/backup-restore.md.
# NICOTIND_MIGRATION_BACKUP=off
# NICOTIND_MIGRATION_BACKUP_KEEP=3

# Daily server update check (GitHub releases poll, cached; drives the Admin
# "Update available" row). On by default — set to off to never phone GitHub.
# NICOTIND_UPDATE_CHECK=off
