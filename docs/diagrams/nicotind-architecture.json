  "cards": [
    {
      "dot": "cyan",
      "title": "Clients",
      "items": [
        "One Angular build ships as web, Capacitor mobile/TV and Electron desktop",
        "Native shells point at any server through a runtime-configurable API base URL"
      ]
    },
    {
      "dot": "emerald",
      "title": "Acquisition",
      "items": [
        "Core carries zero source-specific code \u2014 every source is an external addon",
        "AddonJobPoller drives jobs over the addon protocol; addons drop files in the shared staging folder"
      ]
    },
    {
      "dot": "violet",
      "title": "Library",
      "items": [
        "Organizer names and moves files, scanner incrementally re-tags them into SQLite",
        "Streaming reads bytes straight off the music folder; SQLite answers everything else"
      ]
    },
    {
      "dot": "rose",
      "title": "Access",
      "items": [
        "JWT sessions for people, scoped agent tokens for MCP curation",
        "Every /api group must make an explicit auth decision (check:route-auth)"
      ]
    }
  ]
